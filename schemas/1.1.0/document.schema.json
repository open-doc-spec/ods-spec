          "description": "Asset catalog referencing disk files, schemas, diagrams, or external URLs.",
          "x-ods-lifecycle": {
            "introduced": "1.0.0",
            "spec_version": "1.1",
            "status": "stable",
            "spec": "specs/assets.md#asset-catalog"
          }
        },
        "code": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!.*:[Ll]?\\d+).*$"
              },
              {
                "$ref": "#/$defs/codeBinding"
              }
            ]
          },
          "description": "Bidirectional bindings to source code implementations and test fixtures (string shorthand or detailed object).",
          "x-ods-lifecycle": {
            "introduced": "1.0.0",
            "spec_version": "1.1",
            "status": "stable",
            "spec": "specs/assets.md#source-code-bindings"
