{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/open-doc-spec/ods-spec/main/schemas/1.1.0/ontology.schema.json",
  "title": "ODS Ontology Subsystem Schema (v1.1.0)",
  "description": "Machine-readable JSON Schema for Neuro-Symbolic Ontologies, Entity Schemas, Semantic Relations, and Business Invariant Guardrails.",
  "type": "object",
  "properties": {
    "entity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical name of the entity class (e.g., Customer, Subscription, Order)."
        },
        "domain": {
          "type": "string",
          "description": "Business domain category (e.g., Billing, Identity, Inventory)."
        },
        "extends": {
          "type": "string",
          "description": "Parent entity class for inheritance hierarchy."
        },
        "schema": {
          "type": "string",
          "description": "Path to JSON Schema, Pydantic model, or Zod schema file validating instances."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "unique": {
            "type": "boolean",
            "default": false
          },
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "predicate": {
            "type": "string",
            "enum": [
              "is_a",
              "part_of",
              "owns",
              "governed_by",
              "maps_to",
              "depends_on",
              "derives_from",
              "exercises",
              "custom"
            ]
          },
          "custom_predicate": {
            "type": "string"
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "cardinality": {
            "type": "string",
            "pattern": "^(1|N|0\\.\\.1|1\\.\\.1|0\\.\\.N|1\\.\\.N)$"
          },
          "binding": {
            "type": "object"
          }
        },
        "required": [
          "predicate",
          "target"
        ],
        "additionalProperties": false
      }
    },
    "guardrails": {
      "type": "object",
      "properties": {
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Deterministic boolean assertions that must hold true across all state changes."
        },
        "mutation_gates": {
          "type": "object",
          "properties": {
            "pre_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "post_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
