{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/open-doc-spec/ods-spec/main/schemas/1.1.0/attestation.schema.json",
  "title": "ODS Attestation Subsystem Schema (v1.1.0)",
  "description": "Machine-readable JSON Schema for Attested Computations, Runtimes, Parameters, Executors, and Deterministic Attesters in ODS v1.1.0 / OKF v0.2.",
  "type": "object",
  "properties": {
    "runtime": {
      "type": "string",
      "minLength": 1,
      "description": "Execution runtime engine (e.g. bigquery, postgres, dbt, python, looker)."
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "date",
              "timestamp",
              "array",
              "object"
            ]
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "description": {
            "type": "string"
          },
          "default": {}
        },
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "computation": {
      "type": "string",
      "description": "File path to sanctioned computation script/query if not inline under # Computation heading."
    },
    "executor": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string",
          "minLength": 1,
          "description": "Path to execution instructions, skill, or runner script."
        },
        "receipt": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Evidence fields required in run receipt (e.g., job_id, executed_sql, result)."
        }
      },
      "required": [
        "resource"
      ],
      "additionalProperties": false
    },
    "attester": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string",
          "minLength": 1,
          "description": "Path to deterministic (non-LLM) check script."
        }
      },
      "required": [
        "resource"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "runtime"
  ],
  "additionalProperties": false
}
