        "custom_profile": {
          "$ref": "#/$defs/customProfileDefinition",
          "x-ods-lifecycle": {
            "introduced": "1.0.0",
            "spec_version": "1.1",
            "status": "stable",
            "spec": "specs/profiles.md#custom-profile-contracts"
          }
        }
