{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/open-doc-spec/ods-spec/main/schemas/1.0.0/config.schema.json",
  "title": "ODS Workspace Configuration Schema",
  "description": "Machine-readable JSON Schema for ods.toml workspace configuration.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional URI of the ODS workspace configuration schema."
    },
    "spec": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$",
          "description": "Target ODS specification version (e.g., '1.0' or '1.0.0')."
        },
        "dialect": {
          "type": "string",
          "enum": [
            "standard",
            "strict",
            "agentic"
          ],
          "default": "standard",
          "description": "Enforcement mode for lint rules and validation severity."
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    },
    "ignore": {
      "type": [
        "object",
        "array"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Directory prefixes to exclude from document scanning and graph traversal."
        }
      },
      "items": {
        "type": "string"
      },
      "additionalProperties": false,
      "description": "Paths or configuration table for ignored directories."
    },
    "custom_profiles": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "File paths to registered custom profile markdown definitions."
        }
      },
      "additionalProperties": false
    },
    "packs": {
      "type": "object",
      "properties": {
        "load": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Registered pack identifiers or bundle paths to load into the workspace."
        }
      },
      "additionalProperties": false
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Workspace-wide path or symbol aliases for dependency and related resolution."
    },
    "service": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "poll",
            "watch"
          ],
          "default": "poll",
          "description": "Filesystem change detection strategy for ODS daemon."
        },
        "poll_secs": {
          "type": "integer",
          "minimum": 1,
          "default": 2,
          "description": "Polling interval in seconds when service.mode is 'poll'."
        },
        "max_rss_mb": {
          "type": "integer",
          "minimum": 1,
          "default": 10,
          "description": "Maximum RSS memory budget for background indexing service."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}